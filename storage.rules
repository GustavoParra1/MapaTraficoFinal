rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ✅ Frames - LECTURA PÚBLICA, ESCRITURA SOLO DE PATRULLAS
    match /frames/{patrullaId}/{fileName=**} {
      // Cualquiera puede leer frames (para COM ver cámaras)
      allow read: if true;
      
      // Solo usuarios autenticados de patrullaId pueden escribir
      allow write: if request.auth != null && 
                      request.auth.token.email.startsWith(patrullaId);
    }
    
    // ✅ Todo lo demás - DENEGADO por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
