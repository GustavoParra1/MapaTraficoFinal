rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Frames - LECTURA PUBLICA, ESCRITURA SOLO DE PATRULLAS
    match /frames/{patrullaId}/{fileName=**} {
      // Cualquiera puede leer frames (para COM ver camaras)
      allow read: if true;
      // Solo usuarios autenticados de patrullaId pueden escribir
      allow write: if request.auth != null &&
                      request.auth.token.email.startsWith(patrullaId);
    }

    // Observaciones de campo - fotos del relevamiento por barrio (informe de IA)
    match /observaciones_campo/{barrioSlug}/{fileName=**} {
      allow read, write: if request.auth != null &&
                             request.auth.token.email == 'com@seguridad-mdp.com';
    }

    // Observaciones de campo - fotos del relevamiento por cruce puntual (informe de IA)
    match /observaciones_campo_cruce/{cruceSlug}/{fileName=**} {
      allow read, write: if request.auth != null &&
                             request.auth.token.email == 'com@seguridad-mdp.com';
    }

    // Todo lo demas - DENEGADO por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}