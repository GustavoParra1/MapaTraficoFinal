rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ✅ Frames - LECTURA PÚBLICA, ESCRITURA SOLO DE PATRULLAS
    match /frames/{patrullaId}/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.email.startsWith(patrullaId);
    }

    // 📝 Observaciones de campo - fotos del relevamiento por barrio (informe de IA)
    match /observaciones_campo/{barrioSlug}/{fileName=**} {
      allow read, write: if request.auth != null &&
                             request.auth.token.email == 'com@seguridad-mdp.com';
    }

    // ✅ Todo lo demás - DENEGADO por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}